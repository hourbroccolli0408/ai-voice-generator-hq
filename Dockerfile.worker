FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    VOICEFORGE_DEVICE=cuda \
    VOICEFORGE_ENGINE=chatterbox

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml ./
COPY app ./app
COPY worker ./worker
# Chatterbox pins torch 2.6, which cannot execute on Blackwell GPUs.
# Restore the first stable CUDA 12.8 build with Blackwell support.
RUN pip install --upgrade pip \
    && pip install ".[worker]" \
    && pip install --upgrade --force-reinstall \
        torch==2.7.1 torchaudio==2.7.1 \
        --index-url https://download.pytorch.org/whl/cu128 \
    && python -c "import torch; assert torch.__version__.startswith('2.7.1'); assert torch.version.cuda.startswith('12.8'); print(torch.__version__, torch.version.cuda, torch.cuda.get_arch_list())"

# spacy-pkuseg hard-codes a five-second download timeout. Bundle its verified
# model so cold-start generation never depends on a runtime GitHub download.
RUN python -c "import hashlib, io, urllib.request, zipfile; from pathlib import Path; url='https://github.com/explosion/spacy-pkuseg/releases/download/v0.0.26/spacy_ontonotes.zip'; expected='b216e7f92de7ae285aeab8feba2faa8ea8216e5995ff6fb3d391cc8356db1bfe'; data=urllib.request.urlopen(url, timeout=120).read(); actual=hashlib.sha256(data).hexdigest(); assert actual == expected, actual; target=Path('/root/.pkuseg/spacy_ontonotes'); target.mkdir(parents=True, exist_ok=True); zipfile.ZipFile(io.BytesIO(data)).extractall(target)" \
    && test -f /root/.pkuseg/spacy_ontonotes/features.msgpack \
    && test -f /root/.pkuseg/spacy_ontonotes/weights.npz

CMD ["python", "worker/handler.py"]
