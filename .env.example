# auto chooses CUDA, then Apple MPS, then CPU.
VOICEFORGE_DEVICE=auto

# chatterbox is the real model. mock is only for UI development and tests.
VOICEFORGE_ENGINE=chatterbox

# local runs the model in this process. Production uses the RunPod worker.
VOICEFORGE_WORKER_MODE=local
# VOICEFORGE_RUNPOD_ENDPOINT_ID=
# VOICEFORGE_RUNPOD_API_KEY=

# Limits protect a small self-hosted machine from accidental overload.
VOICEFORGE_MAX_TEXT_CHARS=5000
VOICEFORGE_MAX_UPLOAD_MB=30
VOICEFORGE_WORKERS=1

# Development uses SQLite inside VOICEFORGE_DATA_DIR. Production should use the
# Supabase Postgres pooler connection string.
# VOICEFORGE_DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST:6543/postgres
VOICEFORGE_STARTER_CREDITS=5000

# Set all three for public accounts. The anon key is intentionally public; never
# put the Supabase service-role key in this application.
VOICEFORGE_AUTH_MODE=disabled
# VOICEFORGE_SUPABASE_URL=https://PROJECT.supabase.co
# VOICEFORGE_SUPABASE_ANON_KEY=
# VOICEFORGE_SUPABASE_JWT_SECRET=

# local stores WAV files on disk. Production uses a private Cloudflare R2 bucket.
VOICEFORGE_STORAGE_BACKEND=local
# VOICEFORGE_R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# VOICEFORGE_R2_ACCESS_KEY_ID=
# VOICEFORGE_R2_SECRET_ACCESS_KEY=
# VOICEFORGE_R2_BUCKET=ai-voice-generator-hq
# VOICEFORGE_R2_PUBLIC_URL=

# Optional for private/gated Hugging Face downloads.
# HF_TOKEN=

